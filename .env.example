# Forge environment — copy to `.env` (or `.env.local`) and fill in what you need.
# Values are optional, but both agents need DEEPSEEK_API_KEY or AGENT_API_KEY.

# ── DeepSeek ─────────────────────────────────────────────────
# Server-side credential for both agent proxies. It never reaches the browser.
DEEPSEEK_API_KEY=

# OpenAI-compatible route used by the frontend "deepseek" engine.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic-compatible route used by the frontend "claude" engine.
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── Fallbacks ────────────────────────────────────────────────
# Credential fallback when DEEPSEEK_API_KEY is empty. This is also the
# ANTHROPIC_AUTH_TOKEN equivalent for the Anthropic proxy.
AGENT_API_KEY=

# Base URL fallback when DEEPSEEK_BASE_URL is empty.
# Must be HTTPS, or HTTP only for localhost.
AGENT_BASE_URL=https://api.deepseek.com

# Model fallback when DEEPSEEK_MODEL is empty.
AGENT_MODEL=deepseek-flash

# ── Claude agent settings ────────────────────────────────────
# The browser loop reads these from shared/claude.ts (not from the environment):
# model deepseek-flash[1m], effort high, context 500k / auto-compact 400k,
# opus/sonnet deepseek-v4-pro[1m], haiku/subagent deepseek-flash.

# ── Auth ─────────────────────────────────────────────────────
# Password for the UI unlock screen. Leave empty to disable the gate.
FORGE_PASSWORD=

# Optional stable signing secret for the no-expiry JWT. When empty, the secret
# is derived from FORGE_PASSWORD, so changing the password revokes old tokens.
FORGE_JWT_SECRET=
