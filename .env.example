# Forge agent proxy — copy to `.env` and fill in what you need.
# All values are optional; a key can also be entered in the browser (session only).

# ── DeepSeek proxy ───────────────────────────────────────────
# The browser agent calls POST /api/deepseek/chat/completions with the Forge
# JWT. This key is inserted server-side and never reaches the browser.
DEEPSEEK_API_KEY=

# Route overrides.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Fallbacks ────────────────────────────────────────────────
# Credential fallback when DEEPSEEK_API_KEY is empty.
AGENT_API_KEY=

# Last credential fallback.
OPENAI_API_KEY=

# Base URL fallback when DEEPSEEK_BASE_URL is empty.
# Must be HTTPS, or HTTP only for localhost.
AGENT_BASE_URL=https://api.deepseek.com

# Model fallback when DEEPSEEK_MODEL is empty.
AGENT_MODEL=deepseek-flash

# Password for the UI unlock screen. Leave empty to disable the gate.
FORGE_PASSWORD=

# Optional stable signing secret for the no-expiry JWT. When empty, the secret
# is derived from FORGE_PASSWORD, so changing the password revokes old tokens.
FORGE_JWT_SECRET=
