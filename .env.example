# Forge environment — copy to `.env` (or `.env.local`) and fill in what you need.
# Values are optional, but the Pi harness needs DEEPSEEK_API_KEY or AGENT_API_KEY.

# ── Pi harness ───────────────────────────────────────────────
# Server-side credential. It never reaches the browser.
DEEPSEEK_API_KEY=

# Anthropic-compatible endpoint used by the Pi harness transport.
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Credential fallback when DEEPSEEK_API_KEY is empty.
AGENT_API_KEY=

# ── Pi harness settings ──────────────────────────────────────
# The browser harness reads these from shared/pi.ts (not from the environment):
# model deepseek-flash[1m], thinking medium, context 500k / auto-compact 400k,
# max 100 steps.

# ── Auth ─────────────────────────────────────────────────────
# Password for the UI unlock screen. Leave empty to disable the gate.
FORGE_PASSWORD=

# Optional stable signing secret for the no-expiry JWT. When empty, the secret
# is derived from FORGE_PASSWORD, so changing the password revokes old tokens.
FORGE_JWT_SECRET=
