# Forge agent proxy — copy to `.env` and fill in what you need.
# All values are optional; a key can also be entered in the browser (session only).

# ── DeepSeek Harness SDK ─────────────────────────────────────
# The agent runs as a server-side `dsh --profile sdk` subprocess driven by
# @deepseek-ai/dsh-sdk-client. Its credential is read on the server only.
DEEPSEEK_API_KEY=

# Route overrides. Defaults:
#   provider        deepseek-official
#   model           AGENT_MODEL, then deepseek-v4-flash
#   reasoningEffort max
#   maxTokens       49152
# Set DSH_REASONING_EFFORT or DSH_MAX_TOKENS to an empty value to use the
# model's own default instead.
DSH_PROVIDER=
DSH_MODEL=
DSH_REASONING_EFFORT=
DSH_MAX_TOKENS=

# Harness home. Defaults to data/dsh-home (git-ignored).
DSH_HOME=

# ── Legacy / shared credentials ──────────────────────────────
# Fallback credential for the harness and the legacy /api/agent proxy.
AGENT_API_KEY=

# Last fallback if AGENT_API_KEY is empty.
OPENAI_API_KEY=

# Legacy proxy base URL. Must be HTTPS, or HTTP only for localhost.
# Ollama example: http://localhost:11434/v1
AGENT_BASE_URL=https://api.deepseek.com

# Model fallback for the harness and default for the legacy proxy.
AGENT_MODEL=deepseek-flash

# Password for the UI unlock screen. Leave empty to disable the gate.
FORGE_PASSWORD=

# Optional stable signing secret for the no-expiry JWT. When empty, the secret
# is derived from FORGE_PASSWORD, so changing the password revokes old tokens.
FORGE_JWT_SECRET=
