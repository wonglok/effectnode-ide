{
  "name": "effectnode-ide-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser IDE powered by almostnode, Vite, Nitro, React and Zustand.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node .output/server/index.mjs",
    "preview": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .output .nitro node_modules/.nitro"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.12",
    "almostnode": "0.2.14",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "pako": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "h3": "2.0.1-rc.2",
    "nitro": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
